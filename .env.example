# .env.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# The .env file is git-ignored; this .env.example file is safe to commit.
#
# In production (Runpod):
#   • Set HF_TOKEN and RUNPOD_API_KEY as Runpod Secrets (encrypted at rest).
#   • Set the S3/R2 variables as plain endpoint environment variables,
#     or also as secrets if you prefer.
# ─────────────────────────────────────────────────────────────────────────────

# ── Hugging Face ─────────────────────────────────────────────────────────────
# Required. Must have "read access to gated repositories" scope.
# Request access to the model first: https://huggingface.co/Lightricks/LTX-Video-2-0-5B-Distilled
HF_TOKEN=hf_YOUR_TOKEN_HERE

# ── Runpod ────────────────────────────────────────────────────────────────────
# Your Runpod API key (for runpodctl / API calls). NOT needed inside the handler.
RUNPOD_API_KEY=rpa_YOUR_KEY_HERE

# ── Network volume path override ─────────────────────────────────────────────
# Only needed locally; Runpod always mounts at /runpod-volume.
# RUNPOD_VOLUME_PATH=/runpod-volume

# ── S3-compatible video storage (optional) ────────────────────────────────────
# If set, videos are uploaded here instead of using Runpod's built-in temp storage.
# Works with AWS S3, Cloudflare R2, Backblaze B2, MinIO, etc.
#
# Leave these blank to fall back to Runpod built-in temp storage (1-hour URLs).
S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
# Prefix for video objects in the bucket (no leading slash)
S3_KEY_PREFIX=ltx-2.5
# How long presigned URLs remain valid (seconds). Default: 86400 = 24 hours.
PRESIGNED_URL_TTL_SECONDS=86400

# ── Runpod S3 credentials (for runpodctl or Runpod API uploads) ───────────────
# Only needed if you use Runpod's managed S3 upload helper.
RUNPOD_S3_ACCESS_KEY_ID=YOUR_RUNPOD_S3_KEY
RUNPOD_S3_SECRET_ACCESS_KEY=YOUR_RUNPOD_S3_SECRET
