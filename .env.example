# .env.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# The .env file is git-ignored; this .env.example file is safe to commit.
#
# In production (Runpod):
#   • Set HF_TOKEN and RUNPOD_API_KEY as Runpod Secrets (encrypted at rest).
#   • Set the S3/R2 variables as plain endpoint environment variables,
#     or also as secrets if you prefer.
# ─────────────────────────────────────────────────────────────────────────────

# ── Hugging Face ─────────────────────────────────────────────────────────────
# Required. Must have "read access to gated repositories" scope.
# Request access to the model first: https://huggingface.co/Lightricks/LTX-2.5
HF_TOKEN=hf_YOUR_TOKEN_HERE

# ── Runpod ────────────────────────────────────────────────────────────────────
# Your Runpod API key (for runpodctl / API calls). NOT needed inside the handler.
RUNPOD_API_KEY=rpa_YOUR_KEY_HERE

# ── Network volume path override ─────────────────────────────────────────────
# Only needed locally; Runpod always mounts at /runpod-volume.
# RUNPOD_VOLUME_PATH=/runpod-volume

# ─────────────────────────────────────────────────────────────────────────────
# LTX-2.5 runtime knobs  (all optional — the Dockerfile sets working defaults)
# ─────────────────────────────────────────────────────────────────────────────

# Which transformer checkpoint to load from the network volume.
#   distilled        → ltx-2.5-22b-distilled-transformer-bf16 (default; 8+3 steps)
#   distilled-nvfp4  → the nvfp4 pre-quantized distilled checkpoint
#                      (Blackwell / sm_100+ ONLY — rejected on L40S)
#   dev              → ltx-2.5-22b-dev-transformer-bf16 (slower, non-distilled)
# The *-comfy-int8-convrot checkpoints are ComfyUI-only and are never loadable
# by this PyTorch path — selecting them is deliberately not possible.
# LTX_TRANSFORMER=distilled

# On-the-fly weight quantization. On an L40S (48 GB, sm_89) the bf16 transformer
# alone is ~39 GB, which leaves no room for the VAE + text encoder, so fp8-cast
# is the default. nvfp4-* requires sm_100+ and is rejected below that.
#   fp8-cast | fp8-scaled-mm | nvfp4-cast | nvfp4-prequant | none
# LTX_QUANTIZATION=fp8-cast

# Where to park weights that are not currently executing.
#   none → keep everything resident (fastest; the default)
#   cpu  → offload to host RAM (use for 1080p on a 48 GB card)
#   disk → offload to the network volume (slowest)
# LTX_OFFLOAD_MODE=none

# Which video VAE to use.
#   auto      → prefer the conv VAE if present on the volume, else DiffVAE
#   conv      → ltx-2.5-video-vae-conv-bf16 (faster, lighter)
#   diffusion → ltx-2.5-video-vae-bf16 (higher quality; wants `natten`, which
#               cannot be installed against torch 2.8, so it runs a Triton/eager
#               fallback and is noticeably slower)
# LTX_VIDEO_VAE=auto

# DiffVAE decode strategy — only consulted when the diffusion VAE is in use.
#   chunked_eager | chunked_compile | combined_compile | blackwell_dsl
# combined_compile requires natten; blackwell_dsl requires sm_100+.
# LTX_DIFFVAE_MODE=chunked_eager

# Fetch the conv VAE during cold start if it is not already on the volume.
# Off by default because the volume is nearly full.
# LTX_DOWNLOAD_CONV_VAE=0

# libx264 constant rate factor for the output MP4 (lower = better quality).
# LTX_CRF=19

# ── S3-compatible video storage (recommended) ─────────────────────────────────
# Outputs larger than 5 MB are uploaded here and returned as a presigned URL.
# Works with AWS S3, Cloudflare R2, Backblaze B2, MinIO, etc.
#
# With no storage configured the handler falls back to inlining base64 in the
# job result, which Runpod caps at 20 MB — long or high-resolution clips will
# exceed that, so configure one of the two options below for production.
S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
# Prefix for video objects in the bucket (no leading slash)
S3_KEY_PREFIX=ltx-2.5
# How long presigned URLs remain valid (seconds). Default: 86400 = 24 hours.
PRESIGNED_URL_TTL_SECONDS=86400

# ── Alternative: Runpod's own bucket helper ───────────────────────────────────
# Used only when S3_BUCKET above is unset. These are the exact names
# runpod.serverless.utils.rp_upload reads; it returns a presigned URL valid for
# 7 days and defaults the bucket name to the current "MM-YY" if none is given.
# BUCKET_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# BUCKET_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
# BUCKET_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
